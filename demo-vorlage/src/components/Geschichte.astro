---
import type { CollectionEntry } from 'astro:content';
import Button from './Button.astro';

interface Props {
  demo: CollectionEntry<'demos'>['data'];
  slug: string;
  mode?: 'teaser' | 'full';
}

const { demo, slug, mode = 'full' } = Astro.props;
const image = demo.bilder[1] ?? demo.bilder[0];
---

<section id="ueber-uns" class="relative overflow-hidden" style="background:var(--surface);">
  {demo.farbkleckse && (
    <>
      <svg aria-hidden="true" class="absolute pointer-events-none" style="top:-9%; right:-7%; width:34vw; max-width:420px; opacity:0.9;" viewBox="0 0 400 380" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M150 20 C210 5 270 20 290 60 C330 75 360 130 350 170 C365 210 340 260 300 280 C330 310 320 350 280 355 L200 340 C175 365 130 380 105 355 C90 385 55 382 52 348 C18 338 8 288 50 250 C15 220 10 160 70 110 C55 75 92 35 150 20 Z" fill="var(--accent)" />
        <circle cx="55" cy="60" r="11" fill="var(--accent)" />
        <circle cx="30" cy="95" r="6" fill="var(--accent)" />
        <circle cx="378" cy="205" r="8" fill="var(--accent)" />
      </svg>
      <svg aria-hidden="true" class="absolute pointer-events-none" style="bottom:-10%; left:-8%; width:26vw; max-width:320px; opacity:0.6;" viewBox="0 0 300 280" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M110 15 C155 2 200 15 212 45 C245 55 265 95 245 125 C270 145 260 185 225 195 C240 220 215 250 180 245 L130 250 C110 270 75 265 68 235 C35 232 20 195 45 165 C15 155 12 115 45 95 C40 60 70 25 110 15 Z" fill="var(--accent)" />
        <circle cx="255" cy="55" r="9" fill="var(--accent)" />
        <circle cx="25" cy="115" r="6" fill="var(--accent)" />
      </svg>
    </>
  )}
  <div class="reveal relative grid sm:grid-cols-2 items-center py-16 sm:py-0 max-w-[1800px] mx-auto">
    <div class="relative">
      <div
        class={`w-full aspect-[16/9] max-h-[440px] flex items-center justify-center ${image.src ? '' : 'border border-dashed'}`}
        style="border-color:var(--line); background:var(--bg);"
      >
        {image.src
          ? <img src={image.src} alt={image.alt} class="w-full h-full object-cover" />
          : <p class="text-sm text-center px-6" style="color:var(--ink-soft);">Bild-Platzhalter: {image.alt}</p>}
      </div>
      {demo.gruendungsjahr && (
        <div
          class="absolute bottom-5 right-5 px-5 py-4 text-center"
          style="background:var(--dark); border-radius:var(--radius-card);"
        >
          <p class="font-heading text-2xl" style="color:var(--dark-ink);">{demo.gruendungsjahr}</p>
          <p class="text-[11px] uppercase tracking-widest" style="color:var(--dark-ink-soft);">seit</p>
        </div>
      )}
    </div>
    <div class="flex flex-col justify-center px-6 sm:px-12 lg:px-20 py-10 sm:py-16">
      <p class="kicker mb-4">Unsere Geschichte</p>
      <h2 class="font-heading text-3xl sm:text-4xl mb-5" style="color:var(--ink);">
        Warum <span style="color:var(--accent);">{demo.firmenname}</span>
      </h2>
      <p class="text-lg max-w-xl mb-8" style="color:var(--ink-soft);">{demo.geschichte}</p>
      {mode === 'teaser' && (
        <Button demo={demo} href={`/demo/${slug}/ueber-uns/`}>Mehr über uns</Button>
      )}
    </div>
  </div>
</section>
