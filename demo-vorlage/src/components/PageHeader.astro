---
interface Props {
  kicker: string;
  title: string;
  lede?: string;
}

const { kicker, title, lede } = Astro.props;
---

<section class="px-6 sm:px-12 pt-12 sm:pt-16 pb-8">
  <div class="max-w-[1320px] mx-auto">
    <p class="kicker mb-5">{kicker}</p>
    <h1 class="font-heading text-4xl sm:text-5xl max-w-2xl" style="color:var(--ink);">{title}</h1>
    {lede && <p class="text-lg mt-5 max-w-md" style="color:var(--ink-soft);">{lede}</p>}
  </div>
</section>
