---
// Speisekarten-Teaser auf der Startseite: Chip-Liste aller Kategorien (linkt
// auf die jeweilige Seite im DoenerMenuBook-Flipbook) + Foto-Kacheln der
// Kategorien mit eigenem Bild. Ersetzt Services.astro fuer Kunden mit
// kinoKapitel (siehe [slug]/index.astro).
import type { CollectionEntry } from 'astro:content';
import Button from './Button.astro';
import { slugify } from '../lib/slugify';

interface Props {
  demo: CollectionEntry<'demos'>['data'];
  slug: string;
}

const { demo, slug } = Astro.props;
const kategorien = demo.speisekarteKategorien ?? [];
const gerichteGesamt = kategorien.reduce((sum, k) => sum + k.gerichte.length, 0);
const kacheln = kategorien.filter((k) => k.bild?.src).slice(0, 4);
---

<section class="px-6 sm:px-12 py-16 sm:py-24" style="background:var(--gloss), var(--surface); overflow:hidden;">
  <div class="doener-menu-teaser max-w-[1600px] mx-auto reveal">
    <div class="doener-menu-teaser__text">
      <p class="kicker mb-4">Speisekarte</p>
      <h2 class="font-heading text-3xl sm:text-5xl mb-6" style="color:var(--ink);">Was es bei uns gibt</h2>
      <p class="text-lg mb-8 max-w-[46ch]" style="color:var(--ink-soft);">
        Von unserem Klassiker vom Spieß bis zur Pizza am Montag: über {gerichteGesamt} Gerichte, echte Preise, zum Durchblättern wie bei uns im Laden.
      </p>
      <div class="doener-menu-teaser__chips">
        {kategorien.map((k) => (
          <a class="doener-menu-teaser__chip" href={`/demo/${slug}/leistungen/#${slugify(k.kategorie)}`}>{k.kategorie}</a>
        ))}
      </div>
      <Button demo={demo} href={`/demo/${slug}/leistungen/`}>Speisekarte ansehen</Button>
    </div>
    <div class="doener-menu-teaser__grid">
      {kacheln.map((k) => (
        <a class="doener-menu-teaser__tile" href={`/demo/${slug}/leistungen/#${slugify(k.kategorie)}`}>
          <img src={k.bild!.src} alt={k.bild!.alt} loading="lazy" />
          <span class="doener-menu-teaser__tile-label">{k.kategorie}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .doener-menu-teaser {
    display: grid;
    align-items: center;
    gap: 2.5rem;
  }

  @media (min-width: 900px) {
    .doener-menu-teaser {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 4rem;
    }
  }

  .doener-menu-teaser__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2.25rem;
  }

  .doener-menu-teaser__chip {
    display: inline-block;
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-pill);
    background: var(--bg);
    border: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: 0.8rem;
    font-weight: 600;
    transition: background 0.15s, border-color 0.15s, color 0.15s, transform 0.15s;
  }

  @media (hover: hover) {
    .doener-menu-teaser__chip:hover {
      background: var(--accent);
      border-color: var(--accent);
      color: #fff;
      transform: translateY(-2px);
    }
  }

  .doener-menu-teaser__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.85rem;
  }

  .doener-menu-teaser__tile {
    display: block;
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-card);
    transition: transform 0.25s, box-shadow 0.25s;
  }

  .doener-menu-teaser__tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }

  @media (hover: hover) {
    .doener-menu-teaser__tile:hover {
      transform: translateY(-6px);
      box-shadow: 0 20px 44px -10px color-mix(in srgb, var(--accent) 45%, transparent);
    }

    .doener-menu-teaser__tile:hover img {
      transform: scale(1.06);
    }
  }

  .doener-menu-teaser__tile:after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(rgba(0, 0, 0, 0) 45%, rgba(0, 0, 0, 0.65) 100%);
  }

  .doener-menu-teaser__tile-label {
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.65rem;
    color: #fff;
    font-size: 0.78rem;
    font-weight: 700;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
  }
</style>
