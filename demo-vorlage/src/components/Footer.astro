---
import type { CollectionEntry } from 'astro:content';

interface Props {
  demo: CollectionEntry<'demos'>['data'];
  slug: string;
}

const { demo, slug } = Astro.props;
const base = `/demo/${slug}`;
const social = demo.socialMedia;
// Auf sehr breiten Monitoren wirkte die 1320px-Spalte wie eine schmale
// Saeule in viel Leerraum (Nutzer-Feedback). Nur fuer Bespoke-Kunden
// breiter -- andere Demo-Kunden bleiben bei 1320px.
const bespoke = !!demo.kinoKapitel;
const maxW = bespoke ? 'max-w-[1600px]' : 'max-w-[1320px]';
---

<footer class="px-6 py-16" style="background:var(--gloss), var(--dark); color:var(--dark-ink-soft);">
  <div class={`${maxW} mx-auto grid gap-10 sm:grid-cols-4`}>
    <div class="sm:col-span-2">
      <p class="font-heading text-lg mb-2" style="color:var(--dark-ink);">{demo.firmenname}</p>
      <p class="text-sm mb-4">{demo.branche} · {demo.ort}</p>
      {social && (social.instagram || social.facebook) && (
        <div class="flex items-center gap-3">
          {social.instagram && (
            <a href={social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="footer-social">
              <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1"/></svg>
            </a>
          )}
          {social.facebook && (
            <a href={social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="footer-social">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M14 13.5h2.5l.5-3H14V8.5c0-.87.243-1.5 1.5-1.5H17V4.14C16.73 4.1 15.8 4 14.7 4 12.4 4 11 5.35 11 7.8V10.5H8.5v3H11V21h3v-7.5z"/></svg>
            </a>
          )}
        </div>
      )}
    </div>
    <div class="text-sm space-y-2">
      <a href={demo.leistungenSeiteAusblenden ? `${base}/#leistungen` : `${base}/leistungen/`} class="block hover:opacity-80">{demo.leistungenLabel?.nav ?? 'Leistungen'}</a>
      <a href={`${base}/galerie/`} class="block hover:opacity-80">{demo.galerieLabel?.nav ?? 'Arbeiten'}</a>
      <a href={`${base}/ueber-uns/`} class="block hover:opacity-80">Über uns</a>
      <a href={`${base}/kontakt/`} class="block hover:opacity-80">Kontakt</a>
    </div>
    <div class="text-sm space-y-1">
      <p>{demo.kontakt.adresse}</p>
      <p><a href={`tel:${demo.kontakt.telefon.replace(/\s+/g, '')}`} class="hover:opacity-80">{demo.kontakt.telefon}</a></p>
      {demo.kontakt.email && <p><a href={`mailto:${demo.kontakt.email}`} class="hover:opacity-80">{demo.kontakt.email}</a></p>}
      {demo.kontakt.oeffnungszeiten && <p>{demo.kontakt.oeffnungszeiten}</p>}
    </div>
  </div>
  <div class={`${maxW} mx-auto mt-10 pt-6 border-t text-xs`} style="border-color:var(--dark-ink-soft);">
    Erstellt von <a href="https://böhnpartner.de" class="underline hover:no-underline">Böhn &amp; Partner</a> ·
    Unverbindlicher Entwurf, nicht öffentlich gelistet ·
    <a href="/impressum.html" class="underline hover:no-underline">Impressum</a>
  </div>
</footer>

<style>
  /* Icons vergroessert + eigener Rahmen-Chip statt reinem Liniensymbol --
     Nutzer-Feedback: vorher "viel zu klein, erkennt man kaum". */
  .footer-social {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 999px;
    border: 1.5px solid var(--dark-ink-soft);
    color: var(--dark-ink);
    transition: border-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
  }

  .footer-social:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-2px);
  }
</style>
