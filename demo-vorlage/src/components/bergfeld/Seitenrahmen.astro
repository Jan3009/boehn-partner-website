---
// Gemeinsamer Rahmen der drei Bergfeld-Seiten: Kopf, Navigation, Fuß, Design.
//
// Bewusst NICHT über PageLayout/presets.ts gebaut. Die vier Presets erzeugen
// "gleiche Struktur, andere Akzentfarbe" -- genau der Eindruck, den ein
// Interessent als Agentur-Baukasten erkennt (siehe Kommentar oben in
// presets.ts, das Problem gab es bei v1 schon einmal).
//
// Designentscheidungen (Begründungen in PLANUNG-fliesen-bergfeld.md):
//  - Hell statt dunkel: alle bestehenden Handwerks-Demos sind dunkel.
//  - Salbeigrün als Akzent: Terracotta lag zu nah am eigenen Marken-Orange
//    #C2541F, im Demo-Bestand sind Gold, Rot, Navy und zwei Orangetöne belegt.
//  - Radius 2px: Fliese ist ein kantiges Material.
//  - Asymmetrisches Raster, keine Dreier-Kachelreihe mit Icons -- das
//    symmetrische Icon-Grid ist das deutlichste Erkennungsmerkmal generierter
//    Seiten.
import '../../styles/global.css';
import EntwurfBar from '../EntwurfBar.astro';
import { betrieb, telefonHref } from './betrieb';

interface Props {
  titel: string;
  beschreibung: string;
  aktiv: 'start' | 'leistungen' | 'kontakt';
  /** true auf Seiten ohne dunklen Hero -- der Kopf steht dann auf hellem Grund. */
  heller_kopf?: boolean;
}

const { titel, beschreibung, aktiv, heller_kopf = false } = Astro.props;

const nav = [
  { href: '/demo/fliesen-bergfeld/', label: 'Start', id: 'start' },
  { href: '/demo/fliesen-bergfeld/leistungen/', label: 'Leistungen', id: 'leistungen' },
  { href: '/demo/fliesen-bergfeld/kontakt/', label: 'Kontakt', id: 'kontakt' },
];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{titel}</title>
    <meta name="description" content={beschreibung} />
  </head>
  <body class="bf">
    <EntwurfBar />

    <header class={`bf-kopf${heller_kopf ? ' ist-hell' : ''}`}>
      <div class="bf-kopf-innen">
        <a class="bf-marke" href="/demo/fliesen-bergfeld/">
          <span class="bf-marke-name">Fliesen Bergfeld</span>
          <span class="bf-marke-zusatz">Fliesenlegermeister · {betrieb.ort}</span>
        </a>
        <nav class="bf-nav" aria-label="Hauptnavigation">
          {nav.map((n) => (
            <a href={n.href} aria-current={aktiv === n.id ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
        <a class="bf-kopf-tel" href={telefonHref}>{betrieb.telefon}</a>
      </div>
    </header>

    <main><slot /></main>

    <script>
      // Hero-Parallax: Bild läuft langsamer als die Seite, Textblock zieht
      // leicht mit und blendet aus. Gerechnet wird nur in einem rAF-Callback,
      // der Scroll-Listener selbst setzt bloß ein Flag -- sonst rechnet man
      // pro Scroll-Event und das ruckelt.
      (() => {
        const hero = document.querySelector('.bf-hero');
        if (!hero || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const bild = hero.querySelector('.bf-hero-bild');
        const inhalt = hero.querySelector('.bf-hero-inhalt');
        const hinweis = hero.querySelector('.bf-scrollhinweis');
        let offen = false;

        const zeichnen = () => {
          offen = false;
          const y = window.scrollY;
          const hoehe = hero.offsetHeight;
          if (y > hoehe) return; // außerhalb des Heros nichts mehr rechnen
          const anteil = Math.min(y / hoehe, 1);
          if (bild) bild.style.transform = `translate3d(0, ${y * 0.28}px, 0) scale(${1 + anteil * 0.06})`;
          if (inhalt) {
            inhalt.style.transform = `translate3d(0, ${y * -0.12}px, 0)`;
            inhalt.style.opacity = String(Math.max(1 - anteil * 1.7, 0));
          }
          if (hinweis) hinweis.style.opacity = String(Math.max(0.55 - anteil * 2, 0));
        };

        window.addEventListener('scroll', () => {
          if (!offen) { offen = true; requestAnimationFrame(zeichnen); }
        }, { passive: true });
        zeichnen();
      })();

      // Dezentes Einblenden. Bei prefers-reduced-motion bleibt alles sichtbar.
      const ziele = document.querySelectorAll('.bf-auf');
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        ziele.forEach((z) => z.classList.add('sichtbar'));
      } else {
        const beobachter = new IntersectionObserver(
          (eintraege) => {
            for (const e of eintraege) {
              if (e.isIntersecting) {
                e.target.classList.add('sichtbar');
                beobachter.unobserve(e.target);
              }
            }
          },
          { threshold: 0.1 }
        );
        ziele.forEach((z) => beobachter.observe(z));
      }
    </script>

    <footer class="bf-fuss">
      <div class="bf-fuss-innen">
        <div>
          <p class="bf-fuss-name">Fliesen Bergfeld</p>
          <p>
            {betrieb.inhaber}, {betrieb.titel}<br />
            {betrieb.strasse}<br />
            {betrieb.plz} {betrieb.ort}
          </p>
          <p><a href={telefonHref}>{betrieb.telefon}</a></p>
        </div>
        <div>
          <p class="bf-fuss-name">Seiten</p>
          <p>
            <a href="/demo/fliesen-bergfeld/">Start</a><br />
            <a href="/demo/fliesen-bergfeld/leistungen/">Leistungen</a><br />
            <a href="/demo/fliesen-bergfeld/kontakt/">Kontakt</a>
          </p>
        </div>
        <div>
          <p class="bf-fuss-name">Rechtliches</p>
          <p>
            <a href="/impressum.html">Impressum</a><br />
            <a href="/datenschutz.html">Datenschutz</a>
          </p>
        </div>
      </div>
      <p class="bf-fuss-hinweis">
        Musterentwurf. Der Betrieb ist frei erfunden, Anschrift und
        Telefonnummer sind Platzhalter.
      </p>
    </footer>
  </body>
</html>

<style is:global>
  /* Display-Schrift nur fuer diesen Entwurf, self-hosted wie die uebrigen
     Fonts (public/fonts/). Bodoni Moda: hoher Strichstaerkenkontrast, wie er
     in Interior- und Architekturmagazinen ueblich ist -- das erzeugt den
     "teuren" Eindruck, den eine reine Textseite nicht hinbekommt. Nur fuer
     grosse Groessen; im Fliesstext waeren die Haarstriche zu fragil. */
  @font-face {
    font-family: 'Bodoni Moda';
    font-style: normal; font-weight: 700; font-display: swap;
    src: url('/demo/fonts/bodoni-moda-700.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6,
      U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122,
      U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Bodoni Moda';
    font-style: normal; font-weight: 700; font-display: swap;
    src: url('/demo/fonts/bodoni-moda-700-ext.woff2') format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7,
      U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F,
      U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F,
      U+A720-A7FF;
  }

  body.bf {
    --gruen: #5c7a66;
    --gruen-tief: #31443a;
    --nacht: #14100d;
    --nacht-weich: #1e1a16;
    --papier: #f7f4ef;
    --flaeche: #ebe6dd;
    --tinte: #17150f;
    --tinte-leise: #635e54;
    --linie: #d5cfc3;
    --linie-dunkel: rgba(247, 244, 239, 0.16);

    margin: 0;
    background: var(--papier);
    color: var(--tinte);
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 17px;
    line-height: 1.65;
    overflow-wrap: break-word;
    -webkit-font-smoothing: antialiased;
  }
  body.bf h1, body.bf h2, body.bf h3 {
    margin: 0;
    overflow-wrap: normal;
    hyphens: auto;
  }
  body.bf a { color: inherit; }

  /* Display: sehr gross, engere Zeilen, feine Unterschneidung. */
  .bf-display {
    font-family: 'Bodoni Moda', 'Newsreader', Georgia, serif;
    font-weight: 700; line-height: 1.02; letter-spacing: -0.015em;
  }
  .bf-serif { font-family: 'Newsreader', Georgia, serif; font-weight: 600; line-height: 1.12; }

  /* Kleines Versalien-Label -- taucht an vielen Stellen als Taktgeber auf. */
  .bf-label {
    font-size: 0.7rem; letter-spacing: 0.22em; text-transform: uppercase;
    font-weight: 600; margin: 0;
  }

  .bf-bahn { max-width: 72rem; margin: 0 auto; padding-inline: 2rem; }
  .bf-eng { max-width: 40rem; }
  @media (max-width: 40rem) { .bf-bahn { padding-inline: 1.25rem; } }
  .bf-zweispaltig > *, .bf-kopf-innen > *, .bf-fuss-innen > * { min-width: 0; }

  /* ---------- Kopf: über dem dunklen Hero, deshalb hell und transparent ---- */
  .bf-kopf { position: absolute; top: 0; left: 0; right: 0; z-index: 10; color: #f7f4ef; }
  .bf-kopf-innen {
    max-width: 72rem; margin: 0 auto; padding: 1.6rem 2rem;
    display: flex; align-items: center; gap: 2rem; flex-wrap: wrap;
  }
  .bf-marke { text-decoration: none; margin-right: auto; }
  .bf-marke-name {
    display: block; font-family: 'Bodoni Moda', Georgia, serif; font-weight: 700;
    font-size: 1.45rem; letter-spacing: 0.02em;
  }
  .bf-marke-zusatz {
    display: block; font-size: 0.68rem; letter-spacing: 0.2em;
    text-transform: uppercase; opacity: 0.7; margin-top: 0.15rem;
  }
  .bf-nav { display: flex; gap: 1.8rem; font-size: 0.82rem; letter-spacing: 0.1em; text-transform: uppercase; }
  .bf-nav a { text-decoration: none; opacity: 0.75; padding-bottom: 3px; border-bottom: 1px solid transparent; }
  .bf-nav a:hover { opacity: 1; }
  .bf-nav a[aria-current='page'] { opacity: 1; border-bottom-color: currentColor; }
  .bf-kopf-tel {
    font-size: 0.85rem; text-decoration: none; white-space: nowrap;
    border: 1px solid rgba(247, 244, 239, 0.35); padding: 0.5rem 1rem;
    letter-spacing: 0.04em;
  }
  .bf-kopf-tel:hover { background: rgba(247, 244, 239, 0.1); }
  /* Auf Unterseiten ohne dunklen Hero steht der Kopf auf hellem Grund. */
  .bf-kopf.ist-hell { position: static; color: var(--tinte); border-bottom: 1px solid var(--linie); }
  .bf-kopf.ist-hell .bf-kopf-tel { border-color: var(--linie); }
  .bf-kopf.ist-hell .bf-kopf-tel:hover { background: var(--flaeche); }
  @media (max-width: 46rem) {
    .bf-kopf-innen { gap: 0.8rem 1.4rem; padding: 1.1rem 1.25rem; }
    .bf-marke { width: 100%; margin-right: 0; }
    .bf-nav { gap: 1.3rem; font-size: 0.76rem; }
    .bf-kopf-tel { padding: 0.4rem 0.8rem; font-size: 0.78rem; }
  }

  /* ---------- Hero: vollflaechig, dunkel, Bild als Grund ------------------ */
  .bf-hero {
    position: relative; min-height: 92vh; display: flex; align-items: flex-end;
    background: var(--nacht); color: var(--papier); overflow: hidden;
    padding-block: 9rem 4.5rem;
  }
  /* Hero-Foto plus Verlauf darüber. Der Verlauf ist unten am dichtesten --
     dort steht die Headline, und ohne ihn ist weiße Schrift auf einem Foto
     nie zuverlässig lesbar (das Foto kann jederzeit gegen ein helleres
     getauscht werden). */
  .bf-hero-bild {
    position: absolute; inset: -12% 0; will-change: transform;
  }
  .bf-hero-bild img {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }
  .bf-hero-grund {
    position: absolute; inset: 0;
    background:
      /* Elliptischer Schatten unter dem Textblock links unten. Trägt die
         Schrift, ohne das ganze Bild flächig zuzuziehen. */
      radial-gradient(120% 85% at 8% 100%,
        rgba(12, 10, 8, 0.92) 0%,
        rgba(12, 10, 8, 0.7) 35%,
        rgba(12, 10, 8, 0.25) 62%,
        transparent 80%),
      /* Leichter Gesamtschleier, damit helle Motivstellen nicht ausbrennen. */
      linear-gradient(to top, rgba(12, 10, 8, 0.5) 0%, rgba(12, 10, 8, 0.12) 45%, rgba(12, 10, 8, 0.4) 100%);
  }
  @media (max-width: 46rem) {
    /* Schmal liegt der Text über der ganzen Breite, der Links-Verlauf reicht
       dann nicht -- hier wird flächig abgedunkelt. */
    .bf-hero-grund {
      background: linear-gradient(to top,
        rgba(14, 11, 9, 0.93) 0%,
        rgba(14, 11, 9, 0.78) 45%,
        rgba(14, 11, 9, 0.6) 100%);
    }
  }
  .bf-hero-marke {
    position: absolute; right: 2rem; top: 45%; transform: rotate(90deg);
    transform-origin: right center; font-size: 0.68rem; letter-spacing: 0.3em;
    text-transform: uppercase; opacity: 0.4;
  }
  @media (max-width: 60rem) { .bf-hero-marke { display: none; } }
  .bf-hero-inhalt { position: relative; width: 100%; will-change: transform, opacity; }
  /* Textblock unten links, bewusst schmal: er soll auf dem Bild sitzen,
     nicht darüberliegen. */
  .bf-hero-block { max-width: 34rem; }
  .bf-hero h1 { font-size: clamp(2rem, 3.6vw, 3.2rem); }
  .bf-hero .bf-label { color: rgba(247, 244, 239, 0.85); margin-bottom: 1.1rem; }
  .bf-hero-fuss {
    display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem 2rem;
    margin-top: 1.8rem; padding-top: 1.6rem; border-top: 1px solid var(--linie-dunkel);
  }
  .bf-hero-fuss p { margin: 0; opacity: 0.78; font-size: 0.98rem; max-width: 26rem; }

  /* Scroll-Hinweis am unteren Rand: dünne Linie, die langsam durchläuft. */
  .bf-scrollhinweis {
    position: absolute; right: 2rem; bottom: 4.5rem; display: flex;
    align-items: center; gap: 0.9rem; font-size: 0.66rem; letter-spacing: 0.22em;
    text-transform: uppercase; opacity: 0.55; will-change: opacity;
  }
  .bf-scrollhinweis-linie {
    width: 1px; height: 54px; background: rgba(247, 244, 239, 0.25);
    position: relative; overflow: hidden;
  }
  .bf-scrollhinweis-linie::after {
    content: ''; position: absolute; inset-inline: 0; height: 18px;
    background: var(--papier); animation: bf-lauf 2.4s cubic-bezier(0.6, 0, 0.4, 1) infinite;
  }
  @keyframes bf-lauf {
    0% { transform: translateY(-20px); opacity: 0; }
    35% { opacity: 1; }
    100% { transform: translateY(56px); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .bf-scrollhinweis-linie::after { animation: none; } }
  @media (max-width: 60rem) { .bf-scrollhinweis { display: none; } }

  /* ---------- Kennzahlenband -------------------------------------------- */
  .bf-band { background: var(--nacht-weich); color: var(--papier); }
  .bf-band-innen {
    max-width: 72rem; margin: 0 auto; padding: 0 2rem;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
  }
  .bf-band-zelle { padding: 2.2rem 0 2.2rem 1.8rem; border-left: 1px solid var(--linie-dunkel); }
  .bf-band-zelle:first-child { padding-left: 0; border-left: none; }
  .bf-band-wert { font-family: 'Bodoni Moda', Georgia, serif; font-weight: 700; font-size: 2.4rem; line-height: 1; }
  .bf-band-text { font-size: 0.76rem; letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.6; margin: 0.6rem 0 0; }
  @media (max-width: 40rem) {
    .bf-band-innen { padding-inline: 1.25rem; }
    .bf-band-zelle { padding-left: 0; border-left: none; border-top: 1px solid var(--linie-dunkel); padding-block: 1.4rem; }
    .bf-band-zelle:first-child { border-top: none; }
  }

  /* ---------- Abschnitte ------------------------------------------------- */
  .bf-abschnitt { padding-block: 6rem; }
  @media (max-width: 40rem) { .bf-abschnitt { padding-block: 3.5rem; } }
  .bf-abschnitt h2 { font-size: clamp(1.9rem, 4.2vw, 3.1rem); }
  .bf-abschnitt h3 { font-size: 1.02rem; font-weight: 600; margin: 2rem 0 0.4rem; }
  .bf-abschnitt p { margin: 0 0 1.1rem; }
  .bf-abschnitt .bf-label { color: var(--gruen); margin-bottom: 1.2rem; }

  @media (min-width: 58rem) {
    .bf-zweispaltig { display: grid; grid-template-columns: 20rem 1fr; gap: 4.5rem; }
    .bf-zweispaltig > .bf-kopfspalte { position: sticky; top: 3rem; align-self: start; }
  }
  .bf-kopfspalte h2 { margin-bottom: 1rem; }

  /* Dunkle Sektion -- fuer die fachlichen Aussagen, wirkt wie ein Statement */
  .bf-dunkel { background: var(--nacht); color: var(--papier); }
  .bf-dunkel .bf-label { color: var(--gruen); }
  .bf-dunkel p { opacity: 0.82; }
  .bf-dunkel strong { color: #fff; opacity: 1; }
  .bf-hell-flaeche { background: var(--flaeche); }

  /* ---------- Bildflaechen ---------------------------------------------- */
  .bf-bildplatz {
    position: relative; display: flex; flex-direction: column;
    align-items: center; justify-content: center; text-align: center;
    background: repeating-linear-gradient(135deg, #e4ded3 0 20px, #ded7cb 20px 40px);
    color: var(--tinte-leise); padding: 2rem 1.5rem; max-width: 100%;
  }
  .bf-bildplatz--dunkel {
    background: repeating-linear-gradient(135deg, #211d19 0 20px, #1b1713 20px 40px);
    color: rgba(247, 244, 239, 0.62);
  }
  .bf-bildplatz .bf-label { color: var(--gruen); margin-bottom: 0.6rem; }
  .bf-bildplatz span { font-size: 0.88rem; max-width: 28rem; }
  .bf-hoch { aspect-ratio: 3 / 4; }
  .bf-quer { aspect-ratio: 16 / 9; }
  .bf-paar { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; }

  /* ---------- Leistungsliste: grosse Typo-Zeilen ------------------------- */
  .bf-liste { list-style: none; padding: 0; margin: 0; counter-reset: bf; }
  .bf-liste li {
    counter-increment: bf; display: grid; grid-template-columns: 3rem 1fr;
    gap: 1.5rem; padding: 1.6rem 0; border-top: 1px solid var(--linie);
    align-items: baseline;
  }
  .bf-liste li::before {
    content: counter(bf, decimal-leading-zero);
    font-family: 'Bodoni Moda', Georgia, serif; font-weight: 700;
    color: var(--gruen); font-size: 1.1rem;
  }
  .bf-liste-titel {
    font-family: 'Newsreader', Georgia, serif; font-weight: 600;
    font-size: clamp(1.2rem, 2.4vw, 1.6rem); display: block; line-height: 1.2;
  }
  .bf-liste span.bf-liste-text { color: var(--tinte-leise); font-size: 0.96rem; display: block; margin-top: 0.35rem; }
  .bf-dunkel .bf-liste li { border-color: var(--linie-dunkel); }
  .bf-dunkel .bf-liste-text { color: rgba(247, 244, 239, 0.6); }

  /* ---------- Ablaufschritte -------------------------------------------- */
  .bf-schritte { list-style: none; padding: 0; margin: 0; counter-reset: s; }
  .bf-schritte li { counter-increment: s; padding: 1.6rem 0; border-top: 1px solid var(--linie); }
  .bf-schritte li:first-child { border-top: none; }
  .bf-schritte h3 { font-family: 'Newsreader', Georgia, serif; font-size: 1.3rem; font-weight: 600; margin: 0 0 0.35rem; }
  .bf-schritte h3::before {
    content: counter(s, decimal-leading-zero); display: block;
    font-family: 'Bodoni Moda', Georgia, serif; font-size: 0.9rem;
    color: var(--gruen); margin-bottom: 0.5rem;
  }
  .bf-schritte p { margin: 0; color: var(--tinte-leise); }
  .bf-dunkel .bf-schritte li { border-color: var(--linie-dunkel); }
  .bf-dunkel .bf-schritte p { color: rgba(247, 244, 239, 0.65); }

  /* ---------- Knoepfe ---------------------------------------------------- */
  .bf-knopf {
    display: inline-block; background: var(--gruen); color: #fff;
    padding: 1rem 2rem; text-decoration: none; border: none; cursor: pointer;
    font-family: inherit; font-size: 0.8rem; font-weight: 600;
    letter-spacing: 0.16em; text-transform: uppercase;
  }
  .bf-knopf:hover { background: var(--gruen-tief); }
  .bf-knopf--linie {
    background: transparent; border: 1px solid currentColor; color: inherit;
  }
  .bf-knopf--linie:hover { background: rgba(255, 255, 255, 0.1); }
  .bf-tel-gross {
    display: inline-block; font-family: 'Bodoni Moda', Georgia, serif;
    font-weight: 700; font-size: clamp(2rem, 6vw, 3.6rem);
    text-decoration: none; line-height: 1.1;
  }
  .bf-tel-gross:hover { color: var(--gruen); }

  /* ---------- Tabelle ---------------------------------------------------- */
  .bf-tabelle { width: 100%; border-collapse: collapse; }
  .bf-tabelle th, .bf-tabelle td { text-align: left; padding: 1.1rem 1rem 1.1rem 0; border-top: 1px solid var(--linie-dunkel); vertical-align: top; }
  .bf-tabelle th { font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gruen); font-weight: 600; }
  .bf-tabelle td:first-child { font-family: 'Newsreader', Georgia, serif; font-size: 1.15rem; padding-right: 2.5rem; width: 36%; }
  .bf-tabelle td:last-child { opacity: 0.75; font-size: 0.96rem; }
  @media (max-width: 40rem) {
    .bf-tabelle thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .bf-tabelle tr { display: block; border-top: 1px solid var(--linie-dunkel); padding: 1.1rem 0; }
    .bf-tabelle td { display: block; border: none; padding: 0; width: auto !important; }
    .bf-tabelle td:first-child { padding-right: 0; margin-bottom: 0.3rem; }
  }

