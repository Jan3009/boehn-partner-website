---
import '../styles/global.css';
import { presets } from '../presets';
import EntwurfBar from '../components/EntwurfBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DoenerPromoBar from '../components/DoenerPromoBar.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  demo: CollectionEntry<'demos'>['data'];
  slug: string;
  pageTitle?: string;
}

const { demo, slug, pageTitle } = Astro.props;
const preset = presets[demo.style];
const bespoke = !!demo.kinoKapitel;
const title = pageTitle ? `${pageTitle} — ${demo.firmenname}` : `${demo.firmenname} — Website-Entwurf`;
const description = demo.tagline;

// Preset-Werte sind fest codiert (src/presets.ts), akzentfarbe wird über das
// Content-Collection-Schema als #RRGGBB validiert -- beides sicher zu
// interpolieren. Direkt auf <html> gesetzt, damit die Custom Properties
// garantiert zu allen Kind-Elementen kaskadieren.
const themeStyle = [
  `--font-heading:${preset.headingFont}`,
  `--font-heading-weight:${preset.headingWeight}`,
  `--font-heading-tracking:${preset.headingTracking}`,
  `--font-body:${preset.bodyFont}`,
  `--hero-scale:${preset.heroScale}`,
  `--accent:${demo.akzentfarbe}`,
  `--bg:${demo.hintergrund?.bg ?? preset.bg}`,
  `--surface:${demo.hintergrund?.surface ?? preset.surface}`,
  `--ink:${preset.ink}`,
  `--ink-soft:${preset.inkSoft}`,
  `--line:${preset.line}`,
  `--dark:${demo.hintergrund?.dark ?? preset.dark}`,
  `--dark-ink:${preset.darkInk}`,
  `--dark-ink-soft:${preset.darkInkSoft}`,
  `--radius-sm:${preset.radiusSm}`,
  `--radius-card:${preset.radiusCard}`,
  `--radius-lg:${preset.radiusLg}`,
].join('; ');
---

<!doctype html>
<html lang="de" style={themeStyle}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {bespoke && (
      <>
        <link rel="icon" type="image/png" sizes="32x32" href="/demo/images/demos/walsroder-doener/favicon-32.png" />
        <link rel="icon" type="image/png" sizes="16x16" href="/demo/images/demos/walsroder-doener/favicon-16.png" />
        <link rel="apple-touch-icon" href="/demo/images/demos/walsroder-doener/apple-touch-icon.png" />
      </>
    )}
  </head>
  <body class={bespoke ? 'doener-theme' : ''}>
    <EntwurfBar />
    <Header demo={demo} slug={slug} />
    {bespoke && <DoenerPromoBar demo={demo} />}
    <slot />
    <Footer demo={demo} slug={slug} />
    <script>
      const items = document.querySelectorAll('.reveal');
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!prefersReduced && items.length) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12 }
        );
        items.forEach((item) => observer.observe(item));
      } else {
        items.forEach((item) => item.classList.add('is-visible'));
      }
    </script>
  </body>
</html>

<style is:global>
  /* Nutzer-Feedback: die kleine Linie vor Kicker-Labels ("— SPEISEKARTE",
     "— AUS UNSERER KÜCHE" usw.) soll bei Walsroder Döner weg -- nur fuer
     Bespoke-Kunden, andere Demo-Kunden behalten die Linie. */
  body.doener-theme .kicker::before {
    display: none;
  }
</style>
