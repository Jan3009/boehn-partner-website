    bestätigt</b> — sie sind vor einer Veröffentlichung zu prüfen und zu ersetzen.</p>
    <div class="foot-in">
      <span>Fußbodenprojekte Walsrode · Eisenweg 1 · 29664 Walsrode</span>
      <span>Entwurf: Böhn &amp; Partner GbR</span>
    </div>
  </div>
</footer>
    <script is:inline>
(function () {
  'use strict';
  // Erst hier setzen: ohne JS bleibt .rv wirkungslos und alles ist sichtbar.
  document.documentElement.classList.add('js');

  var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  var rv = [].slice.call(document.querySelectorAll('.rv'));

  if (reduce || !('IntersectionObserver' in window)) {
    rv.forEach(function (el) { el.classList.add('in'); });
  } else {
    var io = new IntersectionObserver(function (es) {
      es.forEach(function (e) {
        if (!e.isIntersecting) return;
        e.target.classList.add('in');
        io.unobserve(e.target);            // einmal sichtbar, bleibt sichtbar
      });
    }, { rootMargin: '0px 0px -12% 0px' });
    rv.forEach(function (el) { io.observe(el); });

    // Der Hero zoomt beim Scrollen ganz leicht heraus. Sehr sparsam dosiert --
    // spürbar, aber nicht als Effekt erkennbar.
    var hero = document.getElementById('heroimg');
    var box = hero.parentNode, warte = false;
    function zoom() {
      var r = box.getBoundingClientRect();
      var t = Math.min(1, Math.max(0, -r.top / (r.height || 1)));
      hero.style.transform = 'scale(' + (1.06 - t * 0.06).toFixed(4) + ')';
      warte = false;
    }
    addEventListener('scroll', function () {
      if (!warte) { warte = true; requestAnimationFrame(zoom); }
    }, { passive: true });
    zoom();
  }
})();
</script>
  </body>
</html>
