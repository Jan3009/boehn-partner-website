---
// Startseite des Musterentwurfs "Fliesen Bergfeld".
// Aufbau: dunkler Vollflächen-Hero, Kennzahlenband, danach Wechsel aus hellen
// und dunklen Sektionen. Der Wechsel ist der eigentliche Hebel für den
// "hochwertigen" Eindruck -- eine durchgehend weiße Seite wirkt flach,
// egal wie gut der Text ist.
import Seitenrahmen from '../../components/bergfeld/Seitenrahmen.astro';
import { fliesenBergfeld as betrieb, telHref } from '../../components/bergfeld/betrieb';

const telefonHref = telHref(betrieb);
import Bild from '../../components/bergfeld/Bild.astro';

const kennzahlen = [
  { wert: String(betrieb.gegruendet), text: 'Gegründet' },
  { wert: '4', text: 'Im Betrieb' },
  { wert: '50 km', text: 'Einzugsgebiet' },
  { wert: 'DIN 18534', text: 'Abdichtung nach Norm' },
];

const leistungen = [
  { titel: 'Badsanierung im Bestand', text: 'Unser Schwerpunkt, meist Altbau aus den 1950er- bis 1980er-Jahren.' },
  { titel: 'Bodengleiche Duschen', text: 'Gefälle, Rutschhemmung und Ablauf. Daran hängt das Ergebnis.' },
  { titel: 'Großformatfliesen', text: 'Bis 120 × 260 cm, zu zweit mit Saugheber und im Nivelliersystem.' },
  { titel: 'Naturstein', text: 'Marmor, Schiefer, Granit, mit ehrlichem Hinweis auf die Pflege.' },
  { titel: 'Reparaturen', text: 'Einzelne Fliesen, ausgebrochene Fugen, erneuertes Silikon.' },
];

const ablauf = [
  { schritt: 'Anruf', text: 'Sie schildern kurz, worum es geht. Wir sagen Ihnen am Telefon, ob wir der richtige Betrieb sind und wann wir frühestens können.' },
  { schritt: 'Termin vor Ort', text: 'Wir sehen uns den Raum an, messen auf und prüfen den Untergrund. Das dauert etwa eine halbe Stunde und kostet nichts.' },
  { schritt: 'Angebot', text: 'Innerhalb einer Woche, schriftlich, nach Positionen aufgeschlüsselt. Sie sehen, was Material kostet und was Arbeitszeit.' },
  { schritt: 'Ausführung', text: 'Zum vereinbarten Termin, mit fester Dauer. Wir melden uns, wenn sich etwas verschiebt, nicht erst, wenn Sie nachfragen.' },
];

const nichtImAngebot = [
  { was: 'Neubau über 300 m²', warum: 'Dafür sind wir zu klein. Wir würden Ihren Termin reißen, und das hilft niemandem.' },
  { was: 'Estrich als eigenes Gewerk', warum: 'Wir bringen Estrich ein, wenn er zu unserer Fliesenarbeit gehört. Als Einzelauftrag nehmen wir ihn nicht an.' },
  { was: 'Nur Material liefern', warum: 'Wir verlegen, was wir liefern. Für Fliesen ohne Verlegung ist der Fachhandel die bessere Adresse.' },
];
---

<Seitenrahmen
  titel="Fliesen Bergfeld · Fliesenlegermeister in Verden (Aller)"
  beschreibung="Badsanierung im bewohnten Altbau, bodengleiche Duschen und Großformatfliesen. Meisterbetrieb in Verden (Aller), seit 2011."
  aktiv="start"
  firma={betrieb}
>
  <section class="bf-hero">
    <div class="bf-hero-bild">
      <img
        src="/demo/images/demos/fliesen-bergfeld/hero.webp"
        alt="Dunkel gefliestes Bad mit bodengleicher Dusche hinter einer Glasabtrennung, freistehender Wanne am Fenster und beleuchteter Wandnische"
        width="1536"
        height="1024"
        fetchpriority="high"
      />
    </div>
    <div class="bf-hero-grund" aria-hidden="true"></div>
    <div class="bf-hero-inhalt bf-bahn">
      <div class="bf-hero-block">
        <p class="bf-label">Fliesenlegermeisterbetrieb · {betrieb.ort}</p>
        <h1 class="bf-display">Bäder sanieren, während Sie darin wohnen.</h1>
        <div class="bf-hero-fuss">
          <p>
            Die meisten unserer Aufträge sind Altbauten, in denen jemand lebt.
            Ein funktionierendes Bad am Wochenende, Staubschutz an der Tür,
            ein Termin, der hält.
          </p>
          <a class="bf-knopf" href={telefonHref}>{betrieb.telefon}</a>
        </div>
      </div>
    </div>
    <div class="bf-scrollhinweis" aria-hidden="true">
      <span>Scrollen</span>
      <span class="bf-scrollhinweis-linie"></span>
    </div>
  </section>

  <div class="bf-band">
    <div class="bf-band-innen">
      {kennzahlen.map((k) => (
        <div class="bf-band-zelle">
          <p class="bf-band-wert">{k.wert}</p>
          <p class="bf-band-text">{k.text}</p>
        </div>
      ))}
    </div>
  </div>

  <section class="bf-bahn bf-abschnitt bf-auf">
    <div class="bf-zweispaltig">
      <div class="bf-kopfspalte">
        <p class="bf-label">Der Betrieb</p>
        <h2 class="bf-serif">Vier Leute,<br />ein Ansprechpartner.</h2>
      </div>
      <div>
        <p>
          {betrieb.name} gibt es seit {betrieb.gegruendet}. {betrieb.inhaber} ist{' '}
          {betrieb.titel}, dazu kommen zwei Gesellen und ein Auszubildender.
          Sie haben auf der Baustelle immer denselben Ansprechpartner, und der
          war auch beim Aufmaß dabei.
        </p>
        <p>
          Wir arbeiten für private Eigentümer und für Hausverwaltungen, im
          Umkreis von etwa 50 Kilometern um {betrieb.ort}. Wenn ein Mieter im
          Haus wohnt, stimmen wir die Bad-Ausfallzeit vorher ab. Bei einer
          Komplettsanierung sind das üblicherweise zwei bis drei Wochen.
        </p>
        <div style="margin-top:2.5rem; max-width:24rem;">
          <Bild
            datei="betrieb.webp"
            format="hoch"
            alt={`${betrieb.inhaber} mit Werkzeugkoffer vor dem Firmenwagen`}
            unterschrift={`${betrieb.inhaber}, ${betrieb.titel}`}
          />
        </div>
      </div>
    </div>
  </section>

  <div class="bf-dunkel">
    <section class="bf-bahn bf-abschnitt bf-auf">
      <div class="bf-zweispaltig">
        <div class="bf-kopfspalte">
          <p class="bf-label">Referenz</p>
          <h2 class="bf-display">Reihenhaus,<br />Baujahr 1962.</h2>
        </div>
        <div>
          <p class="bf-label" style="color:var(--gruen); margin-bottom:1.5rem;">7,5 m² · Obergeschoss · Holzbalkendecke</p>
          <p>
            Die alten Fliesen hatten an mehreren Stellen Risse in der Fuge, und
            in einer Ecke war der Estrich unter der Dusche feucht.
          </p>
          <p>
            Die Risse kamen nicht von schlechter Verlegung, sondern vom
            Untergrund: Eine Holzbalkendecke arbeitet, eine Fliese nicht. Wer
            darauf direkt verlegt, bekommt die Bewegung früher oder später in
            der Fuge zu sehen. Wir haben den alten Aufbau herausgenommen, eine{' '}
            <strong>Entkopplungsmatte</strong> eingebaut und darauf neu verlegt.
          </p>
          <p>
            Die feuchte Ecke war ein zweites Thema: Unter der alten Dusche gab
            es keine Abdichtung, nur Fliesenkleber. Der ist nicht wasserdicht,
            das war er nie.
          </p>
          <div class="bf-paar" style="margin-top:2.5rem;">
            <Bild
              datei="vorher.webp"
              format="hoch"
              alt="Das Bad vor der Sanierung: beige Wandfliesen, eingebaute Badewanne unter dem Fenster"
              unterschrift="Vorher"
            />
            <Bild
              datei="nachher.webp"
              format="hoch"
              alt="Dasselbe Bad nach der Sanierung: großformatige dunkle Fliesen, bodengleiche Dusche, schwebender Waschtisch"
              unterschrift="Nachher"
            />
          </div>
        </div>
      </div>
    </section>
  </div>

  <section class="bf-bahn bf-abschnitt bf-auf">
    <div class="bf-zweispaltig">
      <div class="bf-kopfspalte">
        <p class="bf-label">Handwerk</p>
        <h2 class="bf-display">Der teuerste Fehler liegt unter der Fliese.</h2>
      </div>
      <div>
        <p>
          Eine bodengleiche Dusche braucht eine Verbundabdichtung nach{' '}
          <strong>DIN 18534</strong>, im Duschbereich nach
          Wassereinwirkungsklasse <strong>W3-I</strong>. Das ist keine
          Empfehlung, sondern der Stand der Technik.
        </p>
        <p>
          Sichtbar ist davon später nichts. Merkbar wird sie erst, wenn sie
          fehlt: dann meist zwei bis fünf Jahre später, an der Decke des Raums
          darunter. Die Reparatur kostet dann ein Vielfaches der Abdichtung.
        </p>
        <p>
          Deshalb steht die Abdichtung bei uns als eigene Position im Angebot,
          mit Produktangabe. Sie können nachlesen, was verbaut wurde. Wenn Ihnen
          jemand ein Bad anbietet, in dem diese Position fehlt, fragen Sie nach.
        </p>
        <div style="margin-top:2.5rem;">
          <Bild
            datei="abdichtung.webp"
            format="quer"
            alt="Fertige Verbundabdichtung im Duschbereich: türkise Dichtschlämme mit eingearbeiteten Dichtbändern in den Ecken und am Bodenablauf"
            unterschrift="Verbundabdichtung mit Dichtband in allen Ecken und am Ablauf, vor dem Verfliesen"
          />
        </div>
      </div>
    </div>
  </section>

  <div class="bf-hell-flaeche">
    <section class="bf-bahn bf-abschnitt bf-auf">
      <div class="bf-zweispaltig">
        <div class="bf-kopfspalte">
          <p class="bf-label">Leistungen</p>
          <h2 class="bf-serif">Was wir machen.</h2>
        </div>
        <div>
          <ul class="bf-liste">
            {leistungen.map((l) => (
              <li>
                <div>
                  <span class="bf-liste-titel">{l.titel}</span>
                  <span class="bf-liste-text">{l.text}</span>
                </div>
              </li>
            ))}
          </ul>
          <p style="margin-top:2.5rem;">
            <a class="bf-knopf bf-knopf--linie" href="/demo/fliesen-bergfeld/leistungen/">Alle Leistungen</a>
          </p>
        </div>
      </div>
    </section>
  </div>

  <section class="bf-bahn bf-abschnitt bf-auf">
    <div class="bf-zweispaltig">
      <div class="bf-kopfspalte">
        <p class="bf-label">Ablauf</p>
        <h2 class="bf-serif">Vom Anruf bis zur letzten Fuge.</h2>
      </div>
      <ol class="bf-schritte">
        {ablauf.map((s) => (
          <li><h3>{s.schritt}</h3><p>{s.text}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <div class="bf-dunkel">
    <section class="bf-bahn bf-abschnitt bf-auf">
      <div class="bf-zweispaltig">
        <div class="bf-kopfspalte">
          <p class="bf-label">Abgrenzung</p>
          <h2 class="bf-display">Was wir nicht machen.</h2>
        </div>
        <div>
          <p style="margin-bottom:1.5rem;">Damit Sie sich den Anruf sparen, wenn wir nicht passen:</p>
          <table class="bf-tabelle">
            <thead><tr><th>Nicht im Angebot</th><th>Warum</th></tr></thead>
            <tbody>
              {nichtImAngebot.map((n) => (
                <tr><td>{n.was}</td><td>{n.warum}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </div>

  <div class="bf-hell-flaeche">
    <section class="bf-bahn bf-abschnitt" style="text-align:center;">
      <p class="bf-label" style="color:var(--gruen);">Kontakt</p>
      <h2 class="bf-display" style="margin:1.2rem auto 1.5rem; max-width:14ch;">Sprechen Sie uns an.</h2>
      <a class="bf-tel-gross" href={telefonHref}>{betrieb.telefon}</a>
      <p style="max-width:34rem; margin:1.5rem auto 2rem; color:var(--tinte-leise);">
        Montags bis freitags zwischen 7 und 17 Uhr. Wenn wir auf der Baustelle
        sind, rufen wir zurück.
      </p>
      <a class="bf-knopf" href="/demo/fliesen-bergfeld/kontakt/">Anfrage schreiben</a>
    </section>
  </div>
</Seitenrahmen>
