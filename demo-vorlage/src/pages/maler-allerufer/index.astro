---
// Startseite des Musterentwurfs "Malerwerkstatt Allerufer".
//
// Reihenfolge nach Recherche zu Handwerks-Websites: 60-85 % der Besucher
// kommen per Handy, und der häufigste Fehler ist zu viel Inhalt auf der
// Startseite. Deshalb hier nur die Punkte, die eine Entscheidung tragen --
// Ergebnis zuerst (Vorher/Nachher ist beim Maler das stärkste Argument),
// die fachliche Tiefe steht auf der Leistungsseite.
import Seitenrahmen from '../../components/bergfeld/Seitenrahmen.astro';
import Bild from '../../components/bergfeld/Bild.astro';
import { malerAllerufer as betrieb, telHref } from '../../components/bergfeld/betrieb';

const telefonHref = telHref(betrieb);
const o = betrieb.bildordner;

const kennzahlen = [
  { wert: String(betrieb.gegruendet), text: 'Gegründet' },
  { wert: '5', text: 'Im Betrieb' },
  { wert: '50 km', text: 'Einzugsgebiet' },
];

const leistungen = [
  { titel: 'Innenanstriche', text: 'Wohnungen, Treppenhäuser, Büros. Meist im bewohnten Zustand.' },
  { titel: 'Spachtelarbeiten', text: 'Von Q2 bis Q4, je nachdem wie das Licht im Raum steht.' },
  { titel: 'Fassadenanstriche', text: 'Silikat, Silikonharz oder Dispersion, je nach Untergrund.' },
  { titel: 'Lackierarbeiten', text: 'Türen, Zargen, Fenster, Heizkörper. Innen wasserbasiert.' },
  { titel: 'Tapezierarbeiten', text: 'Raufaser bis Vlies, auch das Entfernen alter Schichten.' },
];

const ablauf = [
  { schritt: 'Anruf', text: 'Wir sagen Ihnen am Telefon, ob wir passen und wann wir können.' },
  { schritt: 'Termin vor Ort', text: 'Räume ansehen, Untergrund prüfen. Eine halbe Stunde, kostenlos.' },
  { schritt: 'Angebot', text: 'Innerhalb einer Woche, nach Positionen, Spachtelstufe als eigene Zeile.' },
  { schritt: 'Ausführung', text: 'Zum vereinbarten Termin, mit fester Dauer.' },
];
---

<Seitenrahmen
  titel="Malerwerkstatt Allerufer · Malermeister in Verden (Aller)"
  beschreibung="Innenanstriche im bewohnten Altbau, Spachtelarbeiten von Q2 bis Q4, Fassaden und Lackierungen. Meisterbetrieb in Verden (Aller), seit 2009."
  aktiv="start"
  firma={betrieb}
>
  <section class="bf-hero bf-hero--hell">
    <div class="bf-hero-bild">
      <img
        src="/demo/images/demos/maler-allerufer/hero.webp"
        alt="Frisch gestrichener Wohnraum in gedecktem Taupe, Streiflicht vom Fenster wirft Schatten über die Wand"
        width="1536"
        height="1024"
        fetchpriority="high"
      />
    </div>
    <div class="bf-hero-grund" aria-hidden="true"></div>
    <div class="bf-hero-inhalt bf-bahn">
      <div class="bf-hero-block">
        <p class="bf-label">Malermeisterbetrieb · {betrieb.ort}</p>
        <h1 class="bf-display">Renovieren, ohne dass Sie ausziehen müssen.</h1>
        <div class="bf-hero-fuss">
          <p>
            Möbel in die Mitte, Folie auf den Boden, abends wieder benutzbar.
          </p>
          <a class="bf-knopf" href={telefonHref}>{betrieb.telefon}</a>
        </div>
      </div>
    </div>
    <div class="bf-scrollhinweis" aria-hidden="true">
      <span>Scrollen</span>
      <span class="bf-scrollhinweis-linie"></span>
    </div>
  </section>

  <div class="bf-band">
    <div class="bf-band-innen">
      {kennzahlen.map((k) => (
        <div class="bf-band-zelle">
          <p class="bf-band-wert">{k.wert}</p>
          <p class="bf-band-text">{k.text}</p>
        </div>
      ))}
    </div>
  </div>

  <div class="bf-dunkel">
    <section class="bf-bahn bf-abschnitt bf-auf">
      <div class="bf-zweispaltig">
        <div class="bf-kopfspalte">
          <p class="bf-label">Referenz</p>
          <h2 class="bf-display">Altbauwohnung,<br />Baujahr 1954.</h2>
        </div>
        <div>
          <div class="bf-paar">
            <Bild ordner={o} datei="vorher.webp" format="hoch" unterschrift="Vorher"
              alt="Der Raum vor den Arbeiten: fleckige Decke, abblätternder Putz, dunkle Ränder in der Ecke" />
            <Bild ordner={o} datei="nachher.webp" format="hoch" unterschrift="Nachher"
              alt="Derselbe Raum nach den Arbeiten: gleichmäßig gestrichene Wände, saubere Decke, neue Fußleisten" />
          </div>
          <p style="margin-top:1.6rem;">
            Vier Räume, 78 m². Im Flur ließ sich die alte Farbe mit dem Finger
            abwischen, das war <strong>Leimfarbe</strong> und musste erst nass
            abgewaschen werden. Über der Heizung und an der Küchendecke kam{' '}
            <strong>Sperrgrund</strong> drauf, sonst schlagen Nikotin und
            Wasserflecken durch jeden neuen Anstrich.
          </p>
        </div>
      </div>
    </section>
  </div>

  <section class="bf-bahn bf-abschnitt bf-auf">
    <div class="bf-zweispaltig">
      <div class="bf-kopfspalte">
        <p class="bf-label">Leistungen</p>
        <h2 class="bf-serif">Was wir machen.</h2>
      </div>
      <div>
        <ul class="bf-liste">
          {leistungen.map((l) => (
            <li>
              <div>
                <span class="bf-liste-titel">{l.titel}</span>
                <span class="bf-liste-text">{l.text}</span>
              </div>
            </li>
          ))}
        </ul>
        <p style="margin-top:2rem;">
          <a class="bf-knopf bf-knopf--linie" href={`${betrieb.basis}leistungen/`}>Alle Leistungen</a>
        </p>
      </div>
    </div>
  </section>

  <div class="bf-hell-flaeche">
    <section class="bf-bahn bf-abschnitt bf-auf">
      <div class="bf-zweispaltig">
        <div class="bf-kopfspalte">
          <p class="bf-label">Handwerk</p>
          <h2 class="bf-serif">Warum Ihre Wand bei Sonne uneben aussieht.</h2>
        </div>
        <div>
          <p>
            Weil Licht von der Seite kommt. Bei <strong>Streiflicht</strong>
            zeichnet sich jede Kelle ab, bei diffusem Licht nicht. Deshalb
            entscheidet vor dem Spachteln nicht der Wunsch, sondern die Frage,
            wo im Raum die Fenster stehen.
          </p>
          <p>
            Dafür gibt es vier Stufen, Q1 bis Q4. Bei uns steht die Stufe als
            eigene Position im Angebot, nicht im Kleingedruckten.
          </p>
          <p style="margin-top:1.6rem;">
            <a href={`${betrieb.basis}leistungen/#spachtel`}>Die vier Stufen im Einzelnen →</a>
          </p>
          <div style="margin-top:2rem;">
            <Bild ordner={o} datei="streiflicht.webp" format="breit"
              alt="Hand mit Glättkelle beim Spachteln einer Wand, seitliches Licht zeichnet die Struktur nach" />
          </div>
        </div>
      </div>
    </section>
  </div>

  <section class="bf-bahn bf-abschnitt bf-auf">
    <div class="bf-zweispaltig">
      <div class="bf-kopfspalte">
        <p class="bf-label">Der Betrieb</p>
        <h2 class="bf-serif">Fünf Leute,<br />ein Ansprechpartner.</h2>
      </div>
      <div>
        <p>
          {betrieb.inhaber} ist {betrieb.titel}, dazu kommen drei Gesellen und
          ein Auszubildender. Sie haben auf der Baustelle immer denselben
          Ansprechpartner, und der war auch beim Aufmaß dabei. Eine
          Dreizimmerwohnung schaffen wir in drei bis fünf Arbeitstagen.
        </p>
        <div style="margin-top:2rem; max-width:22rem;">
          <Bild
            ordner={o}
            datei="betrieb.webp"
            format="hoch"
            alt={`${betrieb.inhaber} in Arbeitskleidung mit Farbeimer und Rolle vor dem Firmenwagen`}
            unterschrift={`${betrieb.inhaber}, ${betrieb.titel}`}
          />
        </div>
      </div>
    </div>
  </section>

  <div class="bf-hell-flaeche">
    <section class="bf-bahn bf-abschnitt bf-auf">
      <div class="bf-zweispaltig">
        <div class="bf-kopfspalte">
          <p class="bf-label">Ablauf</p>
          <h2 class="bf-serif">In vier Schritten.</h2>
        </div>
        <ol class="bf-schritte">
          {ablauf.map((s) => (
            <li><h3>{s.schritt}</h3><p>{s.text}</p></li>
          ))}
        </ol>
      </div>
    </section>
  </div>

  <div class="bf-dunkel">
    <section class="bf-bahn bf-abschnitt" style="text-align:center;">
      <p class="bf-label" style="color:var(--gruen);">Kontakt</p>
      <h2 class="bf-display" style="margin:1.2rem auto 1.5rem; max-width:14ch;">Sprechen Sie uns an.</h2>
      <a class="bf-tel-gross" href={telefonHref}>{betrieb.telefon}</a>
      <p style="max-width:32rem; margin:1.5rem auto 2rem; opacity:0.8;">
        Montags bis freitags, 7 bis 17 Uhr. Wenn wir auf der Baustelle sind,
        rufen wir zurück.
      </p>
      <a class="bf-knopf" href={`${betrieb.basis}kontakt/`}>Anfrage schreiben</a>
    </section>
  </div>
</Seitenrahmen>
