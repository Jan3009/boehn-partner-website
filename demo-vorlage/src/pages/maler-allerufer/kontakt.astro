---
// Kontaktseite. Formularfelder sind fachlich gewählt: Mit "Wohnung, 3 Zimmer,
// Altbau, Raufaser vorhanden" kann ein Maler ein Angebot vorbereiten.
import Seitenrahmen from '../../components/bergfeld/Seitenrahmen.astro';
import { malerAllerufer as betrieb, telHref } from '../../components/bergfeld/betrieb';

const telefonHref = telHref(betrieb);

const einzugsgebiet = [
  'Verden (Aller)', 'Achim', 'Ottersberg', 'Langwedel', 'Kirchlinteln',
  'Dörverden', 'Blender', 'Thedinghausen', 'Rotenburg (Wümme)', 'Walsrode',
];

const danach = [
  { titel: 'Rückmeldung', text: 'Wir melden uns innerhalb von zwei Werktagen zurück.' },
  { titel: 'Termin vor Ort', text: 'Passt es grundsätzlich, sehen wir uns die Räume an. Der Termin dauert etwa eine halbe Stunde und kostet nichts.' },
  { titel: 'Angebot', text: 'Danach bekommen Sie innerhalb einer Woche ein schriftliches Angebot nach Positionen, mit der Spachtelstufe als eigener Zeile.' },
];
---

<Seitenrahmen
  titel="Kontakt · Malerwerkstatt Allerufer"
  beschreibung="Malerwerkstatt Allerufer in Verden (Aller) erreichen: telefonisch oder über das Anfrageformular. Einzugsgebiet rund 50 Kilometer."
  aktiv="kontakt"
  firma={betrieb}
  heller_kopf={true}
>
  <section class="bf-bahn bf-abschnitt">
    <p class="bf-label" style="color:var(--gruen); margin-bottom:1.5rem;">Kontakt</p>
    <h1 class="bf-display" style="font-size:clamp(2.6rem, 7vw, 5rem); max-width:14ch;">So erreichen Sie uns</h1>
    <p class="bf-eng" style="margin:2rem 0 2.5rem; font-size:1.12rem; color:var(--tinte-leise);">
      Am schnellsten geht es telefonisch. Montag bis Freitag, 7 bis 17 Uhr.
      Wenn niemand abnimmt, sind wir auf der Baustelle.
    </p>
    <a class="bf-tel-gross" href={telefonHref}>{betrieb.telefon}</a>
    <p class="bf-eng" style="margin-top:1.5rem; color:var(--tinte-leise);">
      Sprechen Sie auf, wir rufen am selben oder nächsten Tag zurück. Wenn Sie
      einen <strong>festen Übergabetermin</strong> haben, etwa bei einem
      Mieterwechsel, sagen Sie das gleich dazu. Danach richtet sich, ob wir
      überhaupt zusagen können.
    </p>
  </section>

  <section class="bf-bahn bf-abschnitt bf-auf">
    <div class="bf-zweispaltig">
      <div class="bf-kopfspalte">
        <p class="bf-label" style="color:var(--gruen);">Anfrage</p>
        <h2 class="bf-serif">Oder schreiben Sie uns.</h2>
      </div>
      <div>
        <p style="margin-bottom:2rem;">
          Je genauer, desto besser können wir vorbereiten. Sie müssen nicht
          alles wissen. Was Sie nicht beantworten können, lassen Sie leer.
        </p>

        <form>
          <div class="bf-feld-paar">
            <div class="bf-feld">
              <label for="name">Name</label>
              <input type="text" id="name" name="name" autocomplete="name" required />
            </div>
            <div class="bf-feld">
              <label for="telefon">Telefonnummer für den Rückruf</label>
              <input type="tel" id="telefon" name="telefon" autocomplete="tel" required />
            </div>
          </div>

          <div class="bf-feld">
            <label for="ort">Ort</label>
            <input type="text" id="ort" name="ort" autocomplete="address-level2" required />
          </div>

          <div class="bf-feld">
            <label for="art">Worum geht es?</label>
            <select id="art" name="art">
              <option>Komplette Wohnung streichen</option>
              <option>Einzelne Räume</option>
              <option>Treppenhaus oder Gewerbe</option>
              <option>Türen, Fenster, Heizkörper lackieren</option>
              <option>Tapezieren oder Tapete entfernen</option>
              <option>Fassade</option>
              <option>Etwas anderes</option>
            </select>
          </div>

          <div class="bf-feld-paar">
            <div class="bf-feld">
              <label for="raeume">Wie viele Räume oder m²?</label>
              <input type="text" id="raeume" name="raeume" placeholder="z. B. 3 Zimmer, oder: weiß ich nicht" />
            </div>
            <div class="bf-feld">
              <label for="baujahr">Baujahr des Hauses, falls bekannt</label>
              <input type="text" id="baujahr" name="baujahr" placeholder="z. B. 1954" />
            </div>
          </div>

          <div class="bf-feld">
            <label for="untergrund">Was ist aktuell an den Wänden?</label>
            <select id="untergrund" name="untergrund">
              <option>Raufaser, gestrichen</option>
              <option>Glatte Tapete</option>
              <option>Direkt gestrichener Putz</option>
              <option>Alte Farbe, blättert oder wischt ab</option>
              <option>Weiß ich nicht</option>
            </select>
          </div>

          <div class="bf-feld-paar">
            <div class="bf-feld">
              <label for="zeitraum">Wann soll es losgehen?</label>
              <select id="zeitraum" name="zeitraum">
                <option>So schnell wie möglich</option>
                <option>Fester Termin, steht schon</option>
                <option>In den nächsten drei Monaten</option>
                <option>Noch offen, erst mal informieren</option>
              </select>
            </div>
            <div class="bf-feld">
              <label for="rueckruf">Wann erreichen wir Sie?</label>
              <input type="text" id="rueckruf" name="rueckruf" placeholder="z. B. vormittags, oder: nach 18 Uhr" />
            </div>
          </div>

          <div class="bf-feld">
            <label for="nachricht">Was sollen wir noch wissen?</label>
            <textarea id="nachricht" name="nachricht" rows="5"></textarea>
          </div>

          <p style="margin-top:1.5rem;">
            <button class="bf-knopf" type="submit">Anfrage senden</button>
          </p>
          <p style="font-size:0.85rem; color:var(--tinte-leise);">
            Im Musterentwurf ist das Formular ohne Funktion. Es wird nichts
            verschickt und nichts gespeichert.
          </p>
        </form>
      </div>
    </div>
  </section>

  <div class="bf-hell-flaeche">
    <section class="bf-bahn bf-abschnitt bf-auf">
      <div class="bf-zweispaltig">
        <div class="bf-kopfspalte">
          <p class="bf-label" style="color:var(--gruen);">Ablauf</p>
          <h2 class="bf-serif">Was danach passiert.</h2>
        </div>
        <div>
          <ol class="bf-schritte">
            {danach.map((d) => (
              <li><h3>{d.titel}</h3><p>{d.text}</p></li>
            ))}
          </ol>
          <p style="margin-top:1.5rem; color:var(--tinte-leise);">
            Wenn wir absagen, sagen wir das gleich beim ersten Anruf. Und wenn
            wir jemanden kennen, der besser passt, nennen wir Ihnen den.
          </p>
        </div>
      </div>
    </section>
  </div>

  <section class="bf-bahn bf-abschnitt bf-auf">
    <div class="bf-zweispaltig">
      <div class="bf-kopfspalte">
        <p class="bf-label" style="color:var(--gruen);">Einzugsgebiet</p>
        <h2 class="bf-serif">Wo wir arbeiten.</h2>
      </div>
      <div>
        <p>Etwa 50 Kilometer um {betrieb.ort}, unter anderem:</p>
        <p style="font-size:1.02rem; line-height:2;">{einzugsgebiet.join(' · ')}</p>
        <p style="color:var(--tinte-leise);">
          Liegt Ihr Ort nicht dabei, fragen Sie trotzdem. Bei einer ganzen
          Wohnung fahren wir auch weiter, für eine einzelne Tür lohnt sich die
          Anfahrt nicht. Das sagen wir Ihnen ehrlich am Telefon.
        </p>
      </div>
    </div>
  </section>
</Seitenrahmen>
