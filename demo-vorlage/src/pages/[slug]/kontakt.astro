---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ContactForm from '../../components/ContactForm.astro';
import ContactCta from '../../components/ContactCta.astro';

export async function getStaticPaths() {
  const demos = await getCollection('demos');
  return demos.map((entry) => ({
    params: { slug: entry.id },
    props: { demo: entry.data },
  }));
}

const { demo } = Astro.props;
const { slug } = Astro.params;
---

<PageLayout demo={demo} slug={slug} pageTitle="Kontakt">
  <PageHeader kicker="Kontakt" title="Sprich uns an" lede={demo.kontakt.oeffnungszeiten} />
  <section class="px-6 sm:px-12 pb-24 sm:pb-32">
    <div class="reveal max-w-[1320px] mx-auto">
      <ContactForm demo={demo} />
    </div>
  </section>
  <ContactCta demo={demo} />
</PageLayout>
