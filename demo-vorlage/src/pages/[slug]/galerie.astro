---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Gallery from '../../components/Gallery.astro';
import DoenerGallery from '../../components/DoenerGallery.astro';
import ContactCta from '../../components/ContactCta.astro';

export async function getStaticPaths() {
  const demos = await getCollection('demos');
  return demos.map((entry) => ({
    params: { slug: entry.id },
    props: { demo: entry.data },
  }));
}

const { demo } = Astro.props;
const { slug } = Astro.params;
// Eigene Galerie-Seite auch fuer Bespoke-Kunden (aktuell nur Walsroder
// Döner) -- war zwischenzeitlich in die Über-uns-Seite integriert, wirkte
// dort aber wie eine Doppelung zum Speisekarten-Teaser (beides "Foto-Raster
// + Ueberschrift"). Jetzt wieder eigene Seite, Über-uns zeigt nur noch Team
// + Geschichte (Nutzer-Feedback).
const bespoke = !!demo.kinoKapitel;
---

<PageLayout demo={demo} slug={slug} pageTitle={demo.galerieLabel?.nav ?? 'Arbeiten'}>
  {!bespoke && (
    <PageHeader
      kicker={demo.galerieLabel?.kicker ?? 'Fertige Arbeiten'}
      title={demo.galerieLabel?.titel ?? `Was ${demo.firmenname} zuletzt umgesetzt hat`}
    />
  )}
  {bespoke ? <DoenerGallery demo={demo} /> : <Gallery demo={demo} slug={slug} mode="full" />}
  <ContactCta demo={demo} />
</PageLayout>
