---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Gallery from '../../components/Gallery.astro';
import ContactCta from '../../components/ContactCta.astro';

export async function getStaticPaths() {
  const demos = await getCollection('demos');
  return demos.map((entry) => ({
    params: { slug: entry.id },
    props: { demo: entry.data },
  }));
}

const { demo } = Astro.props;
const { slug } = Astro.params;
---

<PageLayout demo={demo} slug={slug} pageTitle="Arbeiten">
  <PageHeader kicker="Fertige Arbeiten" title={`Was ${demo.firmenname} zuletzt umgesetzt hat`} />
  <Gallery demo={demo} slug={slug} mode="full" />
  <ContactCta demo={demo} />
</PageLayout>
