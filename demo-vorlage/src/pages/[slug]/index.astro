---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import Hero from '../../components/Hero.astro';
import CinematicHero from '../../components/CinematicHero.astro';
import Services from '../../components/Services.astro';
import DoenerMenuTeaser from '../../components/DoenerMenuTeaser.astro';
import Geschichte from '../../components/Geschichte.astro';
import DoenerTeam from '../../components/DoenerTeam.astro';
import Gallery from '../../components/Gallery.astro';
import DoenerInfoStrip from '../../components/DoenerInfoStrip.astro';
import Testimonials from '../../components/Testimonials.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import ContactCta from '../../components/ContactCta.astro';

export async function getStaticPaths() {
  const demos = await getCollection('demos');
  return demos.map((entry) => ({
    params: { slug: entry.id },
    props: { demo: entry.data },
  }));
}

const { demo } = Astro.props;
const { slug } = Astro.params;
// Zwei UNABHAENGIGE Schalter statt einem gemeinsamen "bespoke":
// - cinematic: Kunde hat einen Kino-Hero (kinoKapitel) -- z. B. jeder
//   Betrieb mit starken, eigenen Fotos, nicht nur Restaurants. Bekommt den
//   filmischen Scroll-Hero + die generische, aber hochwertigere
//   DoenerTeam-"Über uns"-Kachel (Foto + Zitat + Kennzahlen).
// - speisekarte: Kunde hat eine echte Speisekarte (speisekarteKategorien) --
//   aktuell nur Walsroder Döner. Nur DANN ergeben Menü-Teaser/Info-Kacheln
//   ("Lieferservice", "Terrasse & Parkplatz") ueberhaupt Sinn.
// (Ein voelliger Neuentwurf ohne dieses geteilte Komponenten-Set gehoert NICHT
// hierher, sondern als eigenstaendige Seite unter src/pages/<slug>.astro --
// siehe fliesen-hoelscher.astro / fliesen-yildiz-emmerich.astro als Vorlage.)
const cinematic = !!demo.kinoKapitel;
const speisekarte = !!demo.speisekarteKategorien;
---

<PageLayout demo={demo} slug={slug}>
  {cinematic ? <CinematicHero demo={demo} slug={slug} /> : <Hero demo={demo} slug={slug} />}
  {speisekarte ? <DoenerMenuTeaser demo={demo} slug={slug} /> : <Services demo={demo} slug={slug} mode="teaser" />}
  {cinematic ? <DoenerTeam demo={demo} slug={slug} mode="teaser" /> : <Geschichte demo={demo} slug={slug} mode="teaser" />}
  {speisekarte ? (
    <DoenerInfoStrip demo={demo} />
  ) : (
    !demo.galerieTeaserAusblenden && <Gallery demo={demo} slug={slug} mode="teaser" />
  )}
  <Testimonials demo={demo} mode="teaser" />
  <BeforeAfter demo={demo} />
  <ContactCta demo={demo} />
</PageLayout>
